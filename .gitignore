# downloaded mod archives must never be committed
downloads/
*.7z
*.zip
*.rar
*.ba2

# generated instances
instances/
build/

# credentials — the key itself lives in %USERPROFILE% and never in the repo, but a
# committed API key is unrecoverable (revoke and regenerate is the only fix), so belt
# and braces
.nexus-api-key
*.apikey
*.secret
.env
.env.*

.DS_Store
Thumbs.db

# python
__pycache__/
*.py[cod]
